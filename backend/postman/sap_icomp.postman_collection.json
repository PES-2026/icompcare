    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var resBody = pm.response.json();",
                  "    if (resBody && resBody.user && resBody.user.token) {",
                  "        pm.collectionVariables.set('accessToken', resBody.user.token);",
                  "    }",
                  "    var cookie = pm.cookies.get('accessToken');",
                  "    if (cookie) {",
                  "        pm.collectionVariables.set('accessToken', cookie);",
                  "    }",
                  "    var setCookie = pm.response.headers.get('Set-Cookie');",
                  "    if (setCookie) {",
                  "        var match = setCookie.match(/accessToken=([^;]+)/);",
                  "        if (match && match[1]) {",
                  "            pm.collectionVariables.set('accessToken', match[1]);",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pedagogue@icomp.ufam.edu.br\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
